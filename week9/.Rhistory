library(ggplot2)
library(tidyr)
library(dplyr)
# Generate a normal distribution with mean 0 and standard deviation 1
mean.1 <-0
sd.1 <- 1
zstart <- -4
zend <- 4
zcritical <- 1.65
my_col <- "#00998a"
x <- seq(from = mean.1 - 4*sd.1, to = mean.1 + 4*sd.1, by = .01)
MyDF <- data.frame(x = x, y = dnorm(x, mean = mean.1, sd = sd.1))
shade_curve <- function(MyDF, zstart, zend, fill = "red", alpha = .5){
geom_area(data = subset(MyDF, x >= mean.1 + zstart*sd.1
& x < mean.1 + zend*sd.1),
aes(y=y), fill = fill, color = NA, alpha = alpha)
}
p1a <- ggplot(MyDF, aes(x = x, y = y)) + geom_line() +
shade_curve(MyDF = MyDF, zstart = -1, zend = 1, fill = my_col, alpha = .3) +
shade_curve(MyDF = MyDF, zstart = 1, zend = 2, fill = my_col, alpha = .5) +
shade_curve(MyDF = MyDF, zstart = -2, zend = -1, fill = my_col, alpha = .5) +
shade_curve(MyDF = MyDF, zstart = 2, zend = 6, fill = my_col, alpha = .7) +
shade_curve(MyDF = MyDF, zstart = -3, zend = -2, fill = my_col, alpha = .7) +
scale_x_continuous(breaks = -3:3) +
scale_y_continuous(breaks = NULL) +
theme_classic() +
ylab("") + xlab("")
p1a
p1a <- ggplot(MyDF, aes(x = x, y = y)) + geom_line() +
shade_curve(MyDF = MyDF, zstart = -4, zend = tercile1, fill = my_col, alpha = .3) +
shade_curve(MyDF = MyDF, zstart = tercile1, zend = tercile2, fill = my_col, alpha = .5) +
shade_curve(MyDF = MyDF, zstart = tercile2, zend = 4, fill = my_col, alpha = .5) +
scale_x_continuous(breaks = -3:3) +
scale_y_continuous(breaks = NULL) +
theme_minimal() +
ylab("") + xlab("")
p1a
